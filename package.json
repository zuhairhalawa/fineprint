{
  "name": "fineprint",
  "version": "0.1.0",
  "description": "Check a UAE job offer against UAE labour law before you sign",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "eval": "node --experimental-strip-types eval/run.ts",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-11-01"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true,
    "tesseract.js": false
  },
  "private": true
}
